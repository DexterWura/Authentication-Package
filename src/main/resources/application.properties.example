# Example application.properties file
# Copy this to application.properties and configure for your environment

# Database Configuration
spring.datasource.url=jdbc:postgresql://localhost:5432/authdb
spring.datasource.username=yourusername
spring.datasource.password=yourpassword
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA Configuration
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true

# Email Configuration
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=${MAIL_USERNAME}
spring.mail.password=${MAIL_PASSWORD}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# JWT Configuration
auth.jwt.secret=${JWT_SECRET:your-256-bit-secret-key-change-this-in-production}
auth.jwt.expiration=86400000
auth.jwt.refresh-expiration=604800000

# Email Settings
auth.email.from=${MAIL_FROM:noreply@example.com}
auth.email.verification-url=${EMAIL_VERIFICATION_URL:http://localhost:8080/api/auth/verify-email?token=}
auth.email.reset-password-url=${EMAIL_RESET_URL:http://localhost:8080/api/auth/reset-password?token=}

# Security Configuration
auth.security.public-endpoints=/api/auth/**

# CORS Configuration
auth.cors.allowed-origins=${CORS_ORIGINS:*}
auth.cors.allowed-methods=GET,POST,PUT,DELETE,OPTIONS
auth.cors.allowed-headers=*

# Email Verification
auth.email-verification.enabled=true
auth.email-verification.expiry-hours=24

# Password Reset
auth.password-reset.expiry-hours=1

# Refresh Token
auth.refresh-token.expiry-days=7

# Rate Limiting
auth.rate-limit.enabled=true
auth.rate-limit.requests-per-minute=60
auth.rate-limit.login-requests-per-minute=5

# Logging
logging.level.com.authpackage=INFO
logging.level.org.springframework.security=DEBUG

